# Gemini API Key for SAP DigiTech Live AI Chatbot
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# VPS Source Code Storage
CODE_STORAGE_PATH=/var/www/storage/sapstorage/codes

# SMTP Email Dispatch (for delivering 5-minute customer download links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
ADMIN_EMAIL=admin@sapdigitechsolutions.in
